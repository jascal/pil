.decl contrib(inst:number, v:number, w:float)
contrib(I,V,0.0) :- inst(I), cand(V).      // ⊗-identity pad: sum is always grounded
contrib(I,V,W) :- fired0(I,K), headw0(K,V,W).
.decl biasf(v:number, b:float)
biasf(0,-0.00371973426).
biasf(1,0.00371359824).
.decl logit(inst:number, v:number, s:float)
logit(I,V,B+S) :- inst(I), biasf(V,B), S = sum W : { contrib(I,V,W) }.   // ⊗ over sources
.decl best(inst:number, v:number)
best(I,V) :- logit(I,V,S), S = max S2 : { logit(I,_,S2) }.               // ⊕ at T -> 0
.decl decide(inst:number, v:number)
decide(I,V) :- best(I,V), V = min V2 : { best(I,V2) }.                   // deterministic tie-break
.output decide
